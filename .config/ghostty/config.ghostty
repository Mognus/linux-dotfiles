# Match the previous Alacritty look.
font-family = JetBrainsMono Nerd Font
font-size = 11
background = #0e0e11
foreground = #cdd6f4
background-opacity = 0.7
background-opacity-cells = true
background-blur = true
window-decoration = false
window-padding-x = 12
window-padding-y = 12

# Keep Ctrl+Shift+F free for editor-wide grep.
keybind = ctrl+shift+f=unbind
keybind = ctrl+shift+slash=start_search
