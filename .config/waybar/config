{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces", "group/utilities"],
    "modules-center": ["group/metaphysics"],
    "modules-right": ["group/audio", "group/scratchpads"],

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d.%m.%Y}"
    },

    "group/metaphysics": {
        "orientation": "vertical",
        "modules": ["image#metaphysics", "clock"]
    },

    "image#metaphysics": {
        "path": "/home/magnus/.config/waybar/assets/eye-triangle.svg",
        "size": 20,
        "tooltip": false
    },

    "custom/record": {
        "exec": "~/.config/waybar/scripts/record-status.sh",
        "return-type": "json",
        "interval": 1
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-id": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        },
        "show-special": false
    },

    "group/utilities": {
        "orientation": "horizontal",
        "modules": ["custom/record"]
    },

    "group/audio": {
        "orientation": "horizontal",
        "modules": ["wireplumber"]
    },

    "group/scratchpads": {
        "orientation": "horizontal",
        "modules": ["custom/term-scratchpad", "custom/music-scratchpad", "custom/obsidian-scratchpad", "custom/discord-scratchpad", "custom/firefox-scratchpad"]
    },

    "custom/discord-scratchpad": {
        "exec": "~/.config/waybar/scripts/discord-scratchpad.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 9
    },

    "custom/firefox-scratchpad": {
        "exec": "~/.config/waybar/scripts/firefox-scratchpad.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8
    },

    "custom/cmus-scratchpad": {
        "exec": "~/.config/waybar/scripts/cmus-scratchpad.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 12
    },

    "custom/term-scratchpad": {
        "exec": "~/.config/waybar/scripts/term-scratchpad.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 13
    },

    "custom/music-scratchpad": {
        "exec": "~/.config/waybar/scripts/music-scratchpad.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 11
    },

    "custom/obsidian-scratchpad": {
        "exec": "~/.config/waybar/scripts/obsidian-scratchpad.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 10
    }
}
