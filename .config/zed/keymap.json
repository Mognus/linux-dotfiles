// Zed keymap — see ~/.config/nvim/lua/core/keymaps.lua for the nvim side.
//
// <panel>::Toggle opens and closes a specific panel. <panel>::ToggleFocus only
// moves focus, and workspace::ToggleLeftDock cannot tell project from git panel
// since both share the left dock.
//
// Zed resolves keys innermost-first, so an Editor-level vim binding beats a
// Workspace-level one. The panel keys are therefore declared in both contexts.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-b": "project_panel::Toggle",
      "ctrl-g": "git_panel::Toggle",
      "ctrl-a": "agent::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // Overrides vim: ctrl-b page-up, ctrl-g file info, ctrl-a increment.
      "ctrl-b": "project_panel::Toggle",
      "ctrl-g": "git_panel::Toggle",
      "ctrl-a": "agent::Toggle"
    }
  }
]
