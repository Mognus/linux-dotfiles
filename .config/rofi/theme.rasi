@import "~/.local/state/dotfiles-theme/rofi.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 600px;
    location: center;
    anchor: center;
    border: 1px;
    border-color: @edge;
    border-radius: 0;
    background-color: @bg;
}

mainbox {
    children: [ inputbar, message, listview ];
    padding: 12px;
    spacing: 10px;
}

inputbar {
    padding: 0 0 10px 0;
    spacing: 12px;
    border: 0;
    children: [ prompt, entry ];
}

prompt {
    min-width: 86px;
    padding: 5px 10px;
    border: 0;
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    padding: 6px 8px;
    border: 0;
    background-color: transparent;
    text-color: @fg-soft;
    placeholder: "type to filter";
    placeholder-color: @muted;
    cursor-color: @accent;
}

listview {
    lines: 9;
    columns: 1;
    fixed-height: true;
    spacing: 3px;
}

element {
    padding: 7px 10px;
    spacing: 12px;
    border: 0;
    border-radius: 0;
    background-color: transparent;
}

element normal normal,
element alternate normal,
element normal active,
element alternate active {
    background-color: transparent;
}

element selected {
    background-color: @bg-hover;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    text-color: @fg-soft;
    vertical-align: 0.5;
}

element-text selected {
    text-color: @fg;
}

element-icon selected {
    text-color: @fg;
}

message {
    border: 1px;
    border-color: @danger;
    padding: 8px;
}
